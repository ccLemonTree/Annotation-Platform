PROJECT_NAME=图像标注数据管理平台
VERSION=1.0.0
APP_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=data_platform
DEFAULT_TENANT_ID=1
JWT_SECRET_KEY=
JWT_EXPIRATION=3600
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
MAX_ARCHIVE_UPLOAD_SIZE=10737418240
MAX_ARCHIVE_EXPANDED_SIZE=21474836480
MAX_ARCHIVE_FILES=50000
UPLOAD_RETENTION_DAYS=7
SCENE_CLASSIFICATION_CONCURRENCY=4
AUTOMATION_CONCURRENCY=2
# GPU监控复用已配置的ssh-manager MCP；入口留空时返回未配置，不连接任何服务器。
GPU_SSH_MANAGER_ENTRY=
GPU_SSH_NODE_BINARY=node
GPU_SERVER_NAME=绍兴a100
# 可选独立Fernet密钥；留空按用途从JWT密钥派生，轮换后须重新填写GPU密码。
GPU_CREDENTIAL_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
