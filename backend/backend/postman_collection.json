{
  "info": {
    "name": "数据管理平台API",
    "description": "图像标注数据管理平台API测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"测试用户\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", jsonData.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "项目管理",
      "item": [
        {
          "name": "创建项目",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"测试检测项目\",\n  \"description\": \"这是一个目标检测项目\",\n  \"task_type\": \"detection\",\n  \"class_labels\": [\"cat\", \"dog\", \"person\", \"car\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "获取项目列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "projects"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "获取项目详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects/1",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "1"]
            }
          }
        },
        {
          "name": "更新项目",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"更新后的项目名称\",\n  \"description\": \"更新后的描述\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/projects/1",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "1"]
            }
          }
        },
        {
          "name": "获取项目统计",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects/1/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "1", "stats"]
            }
          }
        },
        {
          "name": "删除项目",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/projects/1",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "资产管理",
      "item": [
        {
          "name": "上传单个资产",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/image.jpg"
                },
                {
                  "key": "project_id",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/assets/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "assets", "upload"]
            }
          }
        },
        {
          "name": "批量上传资产",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "/path/to/image1.jpg"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "/path/to/image2.jpg"
                },
                {
                  "key": "project_id",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/assets/batch-upload",
              "host": ["{{base_url}}"],
              "path": ["api", "assets", "batch-upload"]
            }
          }
        },
        {
          "name": "获取资产列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/assets?project_id=1&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "assets"],
              "query": [
                {
                  "key": "project_id",
                  "value": "1"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "获取资产详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/assets/1",
              "host": ["{{base_url}}"],
              "path": ["api", "assets", "1"]
            }
          }
        },
        {
          "name": "删除资产",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/assets/1",
              "host": ["{{base_url}}"],
              "path": ["api", "assets", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "标注管理",
      "item": [
        {
          "name": "创建标注",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_id\": 1,\n  \"annotation_data\": {\n    \"boxes\": [\n      {\n        \"class_id\": 0,\n        \"class_name\": \"cat\",\n        \"bbox\": [100, 100, 200, 200],\n        \"confidence\": 0.95\n      }\n    ]\n  },\n  \"time_spent\": 120\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/annotations",
              "host": ["{{base_url}}"],
              "path": ["api", "annotations"]
            }
          }
        },
        {
          "name": "获取标注列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/annotations?project_id=1&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "annotations"],
              "query": [
                {
                  "key": "project_id",
                  "value": "1"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "获取资产的标注",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/annotations/asset/1",
              "host": ["{{base_url}}"],
              "path": ["api", "annotations", "asset", "1"]
            }
          }
        },
        {
          "name": "更新标注",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annotation_data\": {\n    \"boxes\": [\n      {\n        \"class_id\": 0,\n        \"class_name\": \"cat\",\n        \"bbox\": [105, 105, 205, 205],\n        \"confidence\": 0.98\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/annotations/1",
              "host": ["{{base_url}}"],
              "path": ["api", "annotations", "1"]
            }
          }
        },
        {
          "name": "审核标注",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"review_comment\": \"标注质量很好\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/annotations/1/review",
              "host": ["{{base_url}}"],
              "path": ["api", "annotations", "1", "review"]
            }
          }
        },
        {
          "name": "删除标注",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/annotations/1",
              "host": ["{{base_url}}"],
              "path": ["api", "annotations", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "用户管理",
      "item": [
        {
          "name": "获取用户列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "获取用户详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/1",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1"]
            }
          }
        },
        {
          "name": "更新用户",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"更新后的名字\",\n  \"email\": \"newemail@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/1",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "健康检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
