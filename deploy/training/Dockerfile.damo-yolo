FROM aisfh5.com:9091/ai/jashan_train@sha256:670d3b9d2dd94aaf1aa2b71508611669f80e6f2c865e3ae020d9d1b0bed41048

COPY damo-yolo/source/ /opt/damo/
COPY detection_trainers /tmp/detection_trainers
RUN python3 -m pip install --no-cache-dir loguru==0.7.3 tabulate==0.9.0 easydict==1.13 thop==0.1.1.post2209072238 \
    && cp -a /tmp/detection_trainers /opt/damo/damo "$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))')/" \
    && rm -rf /tmp/detection_trainers \
    && python3 -I -c "from damo.apis import Trainer; import pycocotools.coco"
COPY damo-yolo/weights/ /opt/weights/
RUN cd /opt/weights && sha256sum -c SHA256SUMS

WORKDIR /output
ENTRYPOINT ["python3", "-I", "-u", "-m", "detection_trainers.damo_yolo"]
